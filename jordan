  <div class="totc-controls">
    <button type="button" class="totc-btn totc-toggle is-active" aria-pressed="true">[ 90s Screensaver: ON ]</button>
    <button type="button" class="totc-btn totc-speed" title="Boost bouncing speed">[ +SPEED ]</button>
    <span class="totc-counter" aria-label="Wall bounce count">BOUNCES: 000</span>
  </div>
  <div class="totc-corner-toast" aria-live="polite">★ EXACT CORNER HIT! ★</div>

  <script>
    (function() {
      const root = document.currentScript.parentElement;
      const stage = root.querySelector('.totc-stage');
      const book = root.querySelector('.totc-book');
      const toggleBtn = root.querySelector('.totc-toggle');
      const speedBtn = root.querySelector('.totc-speed');
      const counterEl = root.querySelector('.totc-counter');
      const toast = root.querySelector('.totc-corner-toast');
      const canvas = root.querySelector('.totc-dust');
      const ctx = canvas.getContext('2d');

      let particles = [];
      let isScreensaver = true; // Default ON
      let isHovered = false;
      let isOpening = false;
      let posX = 60, posY = 60;
      let speedMult = 1;
      let dirX = 1, dirY = 1;
      let spinAngle = 0;
      let hue = 0;
      let bounces = 0;

      function updateCounter() {
        counterEl.textContent = 'BOUNCES: ' + String(bounces).padStart(3, '0');
      }

      function resizeCanvas() {
        if (isScreensaver) {
          canvas.width = window.innerWidth;
          canvas.height = window.innerHeight;
        } else {
          canvas.width = stage.offsetWidth + 60;
          canvas.height = stage.offsetHeight + 60;
        }
      }

      function spawnDust(count, burst, originX, originY) {
        for (let i = 0; i < count; i++) {
          particles.push({
            x: originX !== undefined ? originX + (Math.random() - 0.5) * 40 : Math.random() * canvas.width,
            y: originY !== undefined ? originY + (Math.random() - 0.5) * 40 : (burst ? Math.random() * canvas.height : Math.random() * 50),
            r: Math.random() * 1.8 + 0.7,
            vx: (Math.random() - 0.5) * (burst ? 3.2 : 0.7),
            vy: Math.random() * (burst ? 2.4 : 0.9) + 0.25,
            alpha: Math.random() * 0.65 + 0.3
          });
        }
      }

      function triggerCornerToast() {
        toast.classList.add('show');
        setTimeout(() => toast.classList.remove('show'), 2000);
      }

      function loop() {
        if (isHovered || isOpening) {
          // Smoothly snap front cover toward viewer when hovered so Jordan can read & click easily
          const diff = ((spinAngle + 180) % 360) - 180;
          spinAngle -= diff * 0.18;
          if (Math.abs(diff) < 0.5) spinAngle = 0;
        } else {
          spinAngle = (spinAngle + (isScreensaver ? 1.35 * speedMult : 0.65)) % 360;
        }

        const tiltX = (isHovered || isOpening) ? 0 : Math.sin((spinAngle * Math.PI) / 180) * 5;

        if (isScreensaver) {
          if (!isHovered && !isOpening) {
            const bw = 170;
            const bh = 248;
            const maxX = Math.max(0, window.innerWidth - bw);
            const maxY = Math.max(0, window.innerHeight - bh);

            posX += dirX * 2.6 * speedMult;
            posY += dirY * 2.1 * speedMult;

            let hitX = false;
            let hitY = false;

            if (posX <= 0) { posX = 0; dirX = 1; hitX = true; }
            else if (posX >= maxX) { posX = maxX; dirX = -1; hitX = true; }

            if (posY <= 0) { posY = 0; dirY = 1; hitY = true; }
            else if (posY >= maxY) { posY = maxY; dirY = -1; hitY = true; }

            if (hitX || hitY) {
              bounces += 1;
              updateCounter();
              hue = (hue + 55) % 360;
              book.style.filter = `hue-rotate(${hue}deg)`;
              spawnDust(hitX && hitY ? 50 : 14, true, posX + bw / 2, posY + bh / 2);
              if (hitX && hitY) triggerCornerToast();
            }
          }

          book.style.transform = `translate3d(${posX}px, ${posY}px, 0) perspective(1000px) rotateY(${spinAngle}deg) rotateX(${tiltX}deg)`;
        } else {
          book.style.transform = `rotateY(${spinAngle}deg) rotateX(${tiltX}deg)`;
        }

        // Dust rendering
        ctx.clearRect(0, 0, canvas.width, canvas.height);
        if (Math.random() < 0.28) {
          if (isScreensaver) {
            spawnDust(1, false, posX + 85, posY + 124);
          } else {
            spawnDust(1, false);
          }
        }

        for (let i = particles.length - 1; i >= 0; i--) {
          const p = particles[i];
          p.x += p.vx;
          p.y += p.vy;
          p.alpha -= 0.007;
          if (p.alpha <= 0 || p.y > canvas.height) {
            particles.splice(i, 1);
            continue;
          }
          ctx.fillStyle = `rgba(228, 215, 188, ${p.alpha})`;
          ctx.beginPath();
          ctx.arc(p.x, p.y, p.r, 0, Math.PI * 2);
          ctx.fill();
        }

        requestAnimationFrame(loop);
      }

      function enableScreensaver(initial) {
        isScreensaver = true;
        stage.classList.add('is-roaming');
        toggleBtn.classList.add('is-active');
        toggleBtn.setAttribute('aria-pressed', 'true');
        toggleBtn.textContent = '[ 90s Screensaver: ON ]';
        speedBtn.style.display = '';

        if (initial) {
          posX = Math.max(20, Math.min(window.innerWidth * 0.22, window.innerWidth - 190));
          posY = Math.max(20, Math.min(window.innerHeight * 0.25, window.innerHeight - 270));
        } else {
          const rect = book.getBoundingClientRect();
          posX = Math.max(10, Math.min(rect.left, window.innerWidth - 180));
          posY = Math.max(10, Math.min(rect.top, window.innerHeight - 260));
        }

        document.body.appendChild(canvas);
        document.body.appendChild(book);
        document.body.appendChild(toast);

        canvas.classList.add('is-screensaver');
        book.classList.add('is-screensaver');
        resizeCanvas();
        spawnDust(24, true, posX + 85, posY + 124);
      }

      function disableScreensaver() {
        isScreensaver = false;
        stage.classList.remove('is-roaming');
        toggleBtn.classList.remove('is-active');
        toggleBtn.setAttribute('aria-pressed', 'false');
        toggleBtn.textContent = '[ 90s Screensaver: OFF ]';
        speedBtn.style.display = 'none';

        canvas.classList.remove('is-screensaver');
        book.classList.remove('is-screensaver');
        book.style.filter = '';

        stage.appendChild(canvas);
        stage.appendChild(book);
        root.appendChild(toast);

        resizeCanvas();
        spawnDust(20, true);
      }

      // Start with 90s screensaver active by default
      enableScreensaver(true);
      window.addEventListener('resize', resizeCanvas);
      requestAnimationFrame(loop);

      toggleBtn.addEventListener('click', () => {
        if (isScreensaver) disableScreensaver();
        else enableScreensaver(false);
      });

      // Cycle speed: 1x -> 1.75x -> 2.6x -> 1x
      speedBtn.addEventListener('click', () => {
        if (speedMult === 1) {
          speedMult = 1.75;
          speedBtn.textContent = '[ SPEED: 2X ]';
        } else if (speedMult === 1.75) {
          speedMult = 2.6;
          speedBtn.textContent = '[ SPEED: TURBO ]';
        } else {
          speedMult = 1;
          speedBtn.textContent = '[ +SPEED ]';
        }
        spawnDust(18, true, posX + 85, posY + 124);
      });

      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && isScreensaver) disableScreensaver();
      });

      book.addEventListener('mouseenter', () => {
        isHovered = true;
        spawnDust(12, false, isScreensaver ? posX + 85 : undefined, isScreensaver ? posY + 124 : undefined);
      });

      book.addEventListener('mouseleave', () => {
        isHovered = false;
      });

      // Open cover and redirect to Solidarity Book Club
      book.addEventListener('click', (e) => {
        if (e.metaKey || e.ctrlKey || e.shiftKey || e.button === 1) return;
        e.preventDefault();
        isOpening = true;
        spinAngle = 0;
        book.classList.add('is-opening');
        spawnDust(50, true, isScreensaver ? posX + 85 : undefined, isScreensaver ? posY + 124 : undefined);

        setTimeout(() => {
          window.location.href = book.href;
        }, 480);
      });
    })();
  </script>
</div>
