<div class="totc-embed">
  <style>
    .totc-embed {
      display: flex;
      justify-content: center;
      align-items: center;
      padding: 44px 16px;
      position: relative;
      font-family: Georgia, "Times New Roman", Times, serif;
      box-sizing: border-box;
      user-select: none;
      perspective: 1200px;
    }

    .totc-embed *, .totc-embed *::before, .totc-embed *::after {
      box-sizing: border-box;
    }

    /* Dust canvas overlay */
    .totc-dust {
      position: absolute;
      inset: -20px;
      width: calc(100% + 40px);
      height: calc(100% + 40px);
      pointer-events: none;
      z-index: 15;
    }

    /* Book link wrapper */
    .totc-book {
      display: block;
      position: relative;
      width: 280px;
      height: 410px;
      text-decoration: none;
      cursor: pointer;
      transform-style: preserve-3d;
      transition: transform 0.12s ease-out;
    }

    /* Frayed Ribbon Bookmark that peeks out on hover */
    .totc-ribbon {
      position: absolute;
      bottom: -8px;
      left: 44px;
      width: 18px;
      height: 46px;
      background: #7a1c1c;
      clip-path: polygon(0 0, 100% 0, 100% 100%, 50% 82%, 0 100%);
      box-shadow: 0 3px 6px rgba(0,0,0,0.35);
      transition: transform 0.35s cubic-bezier(0.34, 1.56, 0.64, 1);
      z-index: 1;
    }

    .totc-book:hover .totc-ribbon {
      transform: translateY(14px) rotate(-3deg);
    }

    /* Inside Ex-Libris Page (flashes open on click) */
    .totc-inside {
      position: absolute;
      inset: 0;
      background: #efe6d5;
      background-image: radial-gradient(circle at 75% 25%, rgba(139, 108, 66, 0.16) 0%, transparent 50%);
      border: 1px solid #b5a48b;
      border-left: 10px solid #4a2818;
      border-radius: 3px 7px 7px 3px;
      box-shadow: 6px 10px 24px rgba(0, 0, 0, 0.35), inset 14px 0 22px rgba(70, 50, 30, 0.2);
      padding: 28px 22px;
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      text-align: center;
      color: #2b2118;
      z-index: 2;
    }

    .totc-bookplate {
      border: 2px double #7a5c3c;
      padding: 22px 16px;
      width: 100%;
    }

    .totc-bookplate-top {
      font-size: 10px;
      letter-spacing: 2.5px;
      text-transform: uppercase;
      color: #6e5236;
      margin-bottom: 10px;
    }

    .totc-bookplate-main {
      font-size: 17px;
      letter-spacing: 1px;
      text-transform: uppercase;
      color: #3b2414;
      margin: 0 0 10px 0;
    }

    .totc-bookplate-sub {
      font-size: 12px;
      font-style: italic;
      color: #8f1d1d;
      margin: 0;
    }

    /* Front Cover */
    .totc-cover {
      position: absolute;
      inset: 0;
      background-color: #5a2b23;
      background-image: 
        repeating-linear-gradient(0deg, rgba(0,0,0,0.06) 0px, rgba(0,0,0,0.06) 1px, transparent 1px, transparent 3px),
        repeating-linear-gradient(90deg, rgba(255,255,255,0.03) 0px, rgba(255,255,255,0.03) 1px, transparent 1px, transparent 3px),
        radial-gradient(circle at 30% 25%, rgba(120, 65, 50, 0.4), rgba(35, 14, 10, 0.85));
      border-radius: 3px 7px 7px 3px;
      border: 1px solid #331610;
      border-left: 14px solid #3d1b14;
      box-shadow: 
        4px 0 0 #e6dcc8,
        6px 2px 0 #cfc2a9,
        8px 12px 24px rgba(0, 0, 0, 0.38),
        inset 0 0 24px rgba(0, 0, 0, 0.55),
        inset -2px 0 3px rgba(255, 235, 200, 0.15);
      padding: 28px 20px;
      display: flex;
      flex-direction: column;
      align-items: center;
      text-align: center;
      transform-origin: left center;
      transition: transform 0.55s cubic-bezier(0.25, 0.8, 0.25, 1);
      z-index: 3;
      overflow: hidden;
    }

    /* Dynamic warm lamp sheen that follows mouse */
    .totc-sheen {
      position: absolute;
      inset: 0;
      background: radial-gradient(circle at 50% 50%, rgba(255, 232, 185, 0.16), transparent 65%);
      opacity: 0;
      transition: opacity 0.25s ease;
      pointer-events: none;
    }

    .totc-book:hover .totc-sheen {
      opacity: 1;
    }

    .totc-book.is-opening .totc-cover {
      transform: rotateY(-135deg);
    }

    /* Stamped Old-Timey Title Box */
    .totc-title-frame {
      border: 1px solid rgba(212, 185, 130, 0.45);
      outline: 1px solid rgba(212, 185, 130, 0.2);
      outline-offset: -4px;
      padding: 18px 14px;
      width: 100%;
      color: #d6be8a;
      text-shadow: 0 1px 1px rgba(0, 0, 0, 0.8);
    }

    .totc-title {
      font-size: 20px;
      font-weight: normal;
      letter-spacing: 2px;
      line-height: 1.3;
      margin: 0 0 10px 0;
      text-transform: uppercase;
      color: #d6be8a;
    }

    .totc-author {
      font-size: 12px;
      letter-spacing: 2.5px;
      text-transform: uppercase;
      opacity: 0.85;
      margin: 0;
      color: #d6be8a;
    }

    /* Red Sharpie Scrawl with playful hover wiggle */
    .totc-sharpie {
      position: absolute;
      bottom: 42px;
      left: 16px;
      right: 14px;
      transform: rotate(-11deg);
      pointer-events: none;
      transition: transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
    }

    .totc-book:hover .totc-sharpie {
      transform: rotate(-8deg) scale(1.06);
    }

    .totc-sharpie svg {
      width: 100%;
      height: auto;
      overflow: visible;
      filter: drop-shadow(0 1px 0 rgba(40, 0, 0, 0.35));
    }
  </style>

  <a class="totc-book" href="https://dsaops.org/solidaritybookclub" aria-label="A Tale of Two Cities - Jordan click here to visit Solidarity Book Club">
    <canvas class="totc-dust"></canvas>
    <div class="totc-ribbon" aria-hidden="true"></div>

    <!-- Inside Page revealed briefly on click -->
    <div class="totc-inside" aria-hidden="true">
      <div class="totc-bookplate">
        <div class="totc-bookplate-top">Ex Libris</div>
        <div class="totc-bookplate-main">Solidarity<br>Book Club</div>
        <p class="totc-bookplate-sub">Opening chapter...</p>
      </div>
    </div>

    <!-- Front Cover -->
    <div class="totc-cover">
      <div class="totc-sheen"></div>
      <div class="totc-title-frame">
        <h3 class="totc-title">A Tale of<br>Two Cities</h3>
        <p class="totc-author">Charles Dickens</p>
      </div>

      <!-- Hand-drawn Red Sharpie note -->
      <div class="totc-sharpie" aria-hidden="true">
        <svg viewBox="0 0 240 110" fill="none" stroke="#c81414" stroke-linecap="round" stroke-linejoin="round">
          <!-- "Jordan" -->
          <path d="M26 18 L48 16 M38 17 C38 30 37 42 29 43 C23 43 21 38 23 34" stroke-width="4.2"/>
          <path d="M51 31 C47 31 45 41 51 41 C57 41 58 31 51 31 Z" stroke-width="3.8"/>
          <path d="M64 30 L64 41 M64 34 C67 30 72 30 74 32" stroke-width="3.8"/>
          <path d="M88 16 L88 41 M88 31 C80 30 78 41 87 40" stroke-width="3.8"/>
          <path d="M104 31 C96 31 95 41 103 40 L105 31 L106 41" stroke-width="3.8"/>
          <path d="M113 31 L113 41 M113 33 C117 29 123 30 123 36 L123 41" stroke-width="3.8"/>

          <!-- "click here" -->
          <path d="M36 62 C27 61 26 74 36 73" stroke-width="3.8"/>
          <path d="M44 51 L44 73" stroke-width="3.8"/>
          <path d="M53 62 L53 73 M53 55 L53 56" stroke-width="4"/>
          <path d="M69 62 C61 62 60 73 69 73" stroke-width="3.8"/>
          <path d="M77 51 L77 73 M85 61 L78 67 L86 73" stroke-width="3.8"/>

          <path d="M103 51 L103 73 M103 64 C107 60 113 61 113 67 L113 73" stroke-width="3.8"/>
          <path d="M121 67 L130 66 C130 60 120 60 120 68 C120 74 129 74 132 71" stroke-width="3.8"/>
          <path d="M139 62 L139 73 M139 65 C142 61 146 61 148 63" stroke-width="3.8"/>
          <path d="M154 67 L163 66 C163 60 153 60 153 68 C153 74 162 74 165 71" stroke-width="3.8"/>

          <!-- Underline & Arrow -->
          <path d="M24 83 C75 80 125 81 174 84" stroke-width="3.2"/>
          <path d="M180 79 C194 74 205 65 212 53 M202 55 L212 52 L214 63" stroke-width="3.4"/>
        </svg>
      </div>
    </div>
  </a>

  <script>
    (function() {
      const book = document.currentScript.parentElement.querySelector('.totc-book');
      const sheen = book.querySelector('.totc-sheen');
      const canvas = book.querySelector('.totc-dust');
      const ctx = canvas.getContext('2d');
      let particles = [];
      let lastDustTime = 0;

      function resize() {
        canvas.width = book.offsetWidth + 40;
        canvas.height = book.offsetHeight + 40;
      }
      resize();

      function spawnDust(count, burst, originX, originY) {
        for (let i = 0; i < count; i++) {
          particles.push({
            x: originX !== undefined ? originX + (Math.random() - 0.5) * 30 : Math.random() * canvas.width,
            y: originY !== undefined ? originY + (Math.random() - 0.5) * 30 : (burst ? Math.random() * canvas.height : Math.random() * 50),
            r: Math.random() * 1.8 + 0.6,
            vx: (Math.random() - 0.5) * (burst ? 2.4 : 0.6),
            vy: Math.random() * (burst ? 1.8 : 0.8) + 0.25,
            alpha: Math.random() * 0.65 + 0.25
          });
        }
      }

      function animate() {
        ctx.clearRect(0, 0, canvas.width, canvas.height);
        if (Math.random() < 0.3) spawnDust(1, false);

        for (let i = particles.length - 1; i >= 0; i--) {
          const p = particles[i];
          p.x += p.vx;
          p.y += p.vy;
          p.alpha -= 0.006;
          if (p.alpha <= 0 || p.y > canvas.height) {
            particles.splice(i, 1);
            continue;
          }
          ctx.fillStyle = `rgba(228, 215, 188, ${p.alpha})`;
          ctx.beginPath();
          ctx.arc(p.x, p.y, p.r, 0, Math.PI * 2);
          ctx.fill();
        }
        requestAnimationFrame(animate);
      }
      animate();

      // Interactive 3D tilt + brushing dust off with cursor
      book.addEventListener('mousemove', (e) => {
        if (book.classList.contains('is-opening')) return;
        const rect = book.getBoundingClientRect();
        const x = e.clientX - rect.left;
        const y = e.clientY - rect.top;
        const rotateY = ((x / rect.width) - 0.5) * 16;
        const rotateX = ((y / rect.height) - 0.5) * -14;

        book.style.transform = `rotateX(${rotateX}deg) rotateY(${rotateY}deg) translateY(-4px)`;
        sheen.style.background = `radial-gradient(circle at ${x}px ${y}px, rgba(255, 232, 185, 0.22), transparent 65%)`;

        const now = Date.now();
        if (now - lastDustTime > 45) {
          spawnDust(2, false, x + 20, y + 20);
          lastDustTime = now;
        }
      });

      book.addEventListener('mouseleave', () => {
        book.style.transform = '';
      });

      // Tactile cover-swing before navigating
      book.addEventListener('click', (e) => {
        if (e.metaKey || e.ctrlKey || e.shiftKey || e.button === 1) return;
        e.preventDefault();
        book.style.transform = '';
        book.classList.add('is-opening');
        spawnDust(45, true);

        setTimeout(() => {
          window.location.href = book.href;
        }, 480);
      });
    })();
  </script>
</div>
