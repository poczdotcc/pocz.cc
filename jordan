<div class="totc-embed">
  <style>
    .totc-embed {
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      padding: 36px 16px 28px;
      position: relative;
      font-family: Georgia, "Times New Roman", Times, serif;
      box-sizing: border-box;
      user-select: none;
    }

    .totc-embed *, .totc-embed *::before, .totc-embed *::after,
    .totc-book.is-screensaver, .totc-book.is-screensaver * {
      box-sizing: border-box;
    }

    .totc-stage {
      position: relative;
      width: 280px;
      height: 410px;
      perspective: 1400px;
      display: flex;
      justify-content: center;
      align-items: center;
    }

    /* Retro placeholder shown in block while book is roaming the screen */
    .totc-dock-ghost {
      position: absolute;
      inset: 0;
      border: 2px dashed rgba(122, 98, 72, 0.45);
      border-radius: 6px;
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      text-align: center;
      padding: 24px;
      color: #6e5842;
      font-family: "Courier New", Courier, monospace;
      font-size: 12px;
      letter-spacing: 0.5px;
      opacity: 0;
      pointer-events: none;
      transition: opacity 0.25s ease;
    }

    .totc-stage.is-roaming .totc-dock-ghost {
      opacity: 1;
    }

    .totc-dock-ghost strong {
      display: block;
      font-size: 13px;
      margin-bottom: 6px;
      color: #4a3826;
    }

    /* Dust canvas overlay */
    .totc-dust {
      position: absolute;
      inset: -30px;
      width: calc(100% + 60px);
      height: calc(100% + 60px);
      pointer-events: none;
      z-index: 20;
    }

    .totc-dust.is-screensaver {
      position: fixed;
      inset: 0;
      width: 100vw;
      height: 100vh;
      z-index: 99998;
    }

    /* Book link wrapper */
    .totc-book {
      display: block;
      position: relative;
      width: 280px;
      height: 410px;
      text-decoration: none;
      cursor: pointer;
      transform-style: preserve-3d;
      font-family: Georgia, "Times New Roman", Times, serif;
    }

    /* 90s Screensaver floating state (mounted to document.body) */
    .totc-book.is-screensaver {
      position: fixed;
      top: 0;
      left: 0;
      width: 170px;
      height: 248px;
      margin: 0;
      z-index: 99999;
      will-change: transform;
    }

    .totc-book.is-screensaver .totc-title {
      font-size: 13px;
      letter-spacing: 1.5px;
      margin-bottom: 6px;
    }

    .totc-book.is-screensaver .totc-author {
      font-size: 9px;
      letter-spacing: 1.5px;
    }

    .totc-book.is-screensaver .totc-title-frame {
      padding: 10px 8px;
    }

    .totc-book.is-screensaver .totc-cover {
      padding: 16px 12px;
      border-left-width: 9px;
    }

    .totc-book.is-screensaver .totc-sharpie {
      bottom: 22px;
      left: 8px;
      right: 8px;
    }

    /* Frayed Ribbon Bookmark */
    .totc-ribbon {
      position: absolute;
      bottom: -8px;
      left: 44px;
      width: 18px;
      height: 44px;
      background: #7a1c1c;
      clip-path: polygon(0 0, 100% 0, 100% 100%, 50% 82%, 0 100%);
      box-shadow: 0 3px 6px rgba(0,0,0,0.35);
      transition: transform 0.35s cubic-bezier(0.34, 1.56, 0.64, 1);
      transform: translateZ(-2px);
    }

    .totc-book:hover .totc-ribbon {
      transform: translateZ(-2px) translateY(12px) rotate(-3deg);
    }

    /* Inside Ex-Libris Page */
    .totc-inside {
      position: absolute;
      inset: 0;
      background: #efe6d5;
      background-image: radial-gradient(circle at 75% 25%, rgba(139, 108, 66, 0.16) 0%, transparent 50%);
      border: 1px solid #b5a48b;
      border-left: 10px solid #4a2818;
      border-radius: 3px 7px 7px 3px;
      padding: 24px 18px;
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      text-align: center;
      color: #2b2118;
      transform: translateZ(0px);
    }

    .totc-bookplate {
      border: 2px double #7a5c3c;
      padding: 18px 12px;
      width: 100%;
    }

    .totc-bookplate-top {
      font-size: 10px;
      letter-spacing: 2px;
      text-transform: uppercase;
      color: #6e5236;
      margin-bottom: 8px;
    }

    .totc-bookplate-main {
      font-size: 16px;
      letter-spacing: 1px;
      text-transform: uppercase;
      color: #3b2414;
      margin: 0 0 8px 0;
    }

    .totc-bookplate-sub {
      font-size: 12px;
      font-style: italic;
      color: #8f1d1d;
      margin: 0;
    }

    /* Back Cover */
    .totc-back {
      position: absolute;
      inset: 0;
      background-color: #4a211a;
      background-image:
        repeating-linear-gradient(0deg, rgba(0,0,0,0.07) 0px, rgba(0,0,0,0.07) 1px, transparent 1px, transparent 3px),
        radial-gradient(circle at 50% 50%, rgba(100, 50, 40, 0.35), rgba(28, 10, 7, 0.9));
      border-radius: 7px 3px 3px 7px;
      border: 1px solid #2b110c;
      border-right: 14px solid #381812;
      transform: translateZ(-18px) rotateY(180deg);
      display: flex;
      align-items: flex-end;
      justify-content: center;
      padding-bottom: 24px;
      color: rgba(214, 190, 138, 0.55);
      font-size: 10px;
      letter-spacing: 2px;
      text-transform: uppercase;
    }

    /* Book Spine */
    .totc-spine {
      position: absolute;
      top: 1px;
      bottom: 1px;
      left: -9px;
      width: 18px;
      background: linear-gradient(90deg, #2d120d, #4c221b 50%, #2d120d);
      border-top: 1px solid #240e0a;
      border-bottom: 1px solid #240e0a;
      transform: rotateY(-90deg) translateZ(0px) translateX(-9px);
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .totc-spine span {
      writing-mode: vertical-rl;
      color: rgba(214, 190, 138, 0.75);
      font-size: 9px;
      letter-spacing: 2px;
      text-transform: uppercase;
      white-space: nowrap;
    }

    /* Front Cover */
    .totc-cover {
      position: absolute;
      inset: 0;
      background-color: #5a2b23;
      background-image: 
        repeating-linear-gradient(0deg, rgba(0,0,0,0.06) 0px, rgba(0,0,0,0.06) 1px, transparent 1px, transparent 3px),
        repeating-linear-gradient(90deg, rgba(255,255,255,0.03) 0px, rgba(255,255,255,0.03) 1px, transparent 1px, transparent 3px),
        radial-gradient(circle at 30% 25%, rgba(120, 65, 50, 0.4), rgba(35, 14, 10, 0.85));
      border-radius: 3px 7px 7px 3px;
      border: 1px solid #331610;
      border-left: 14px solid #3d1b14;
      box-shadow: 
        inset 0 0 24px rgba(0, 0, 0, 0.55),
        inset -2px 0 3px rgba(255, 235, 200, 0.15);
      padding: 28px 20px;
      display: flex;
      flex-direction: column;
      align-items: center;
      text-align: center;
      transform-origin: left center;
      transform: translateZ(1px);
      transition: transform 0.55s cubic-bezier(0.25, 0.8, 0.25, 1);
      backface-visibility: hidden;
    }

    .totc-book.is-opening .totc-cover {
      transform: translateZ(1px) rotateY(-135deg);
    }

    /* Stamped Old-Timey Title Box */
    .totc-title-frame {
      border: 1px solid rgba(212, 185, 130, 0.45);
      outline: 1px solid rgba(212, 185, 130, 0.2);
      outline-offset: -4px;
      padding: 18px 14px;
      width: 100%;
      color: #d6be8a;
      text-shadow: 0 1px 1px rgba(0, 0, 0, 0.8);
    }

    .totc-title {
      font-size: 20px;
      font-weight: normal;
      letter-spacing: 2px;
      line-height: 1.3;
      margin: 0 0 10px 0;
      text-transform: uppercase;
      color: #d6be8a;
    }

    .totc-author {
      font-size: 12px;
      letter-spacing: 2.5px;
      text-transform: uppercase;
      opacity: 0.85;
      margin: 0;
      color: #d6be8a;
    }

    /* Red Sharpie Scrawl */
    .totc-sharpie {
      position: absolute;
      bottom: 42px;
      left: 16px;
      right: 14px;
      transform: rotate(-11deg);
      pointer-events: none;
    }

    .totc-sharpie svg {
      width: 100%;
      height: auto;
      overflow: visible;
      filter: drop-shadow(0 1px 0 rgba(40, 0, 0, 0.35));
    }

    /* Retro Control Bar */
    .totc-controls {
      margin-top: 20px;
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      align-items: center;
      gap: 8px;
    }

    .totc-btn {
      background: #231914;
      color: #e6d7b9;
      border: 2px outset #7a6248;
      font-family: "Courier New", Courier, monospace;
      font-size: 12px;
      font-weight: bold;
      letter-spacing: 0.5px;
      padding: 6px 12px;
      cursor: pointer;
      box-shadow: 2px 3px 0 rgba(0,0,0,0.3);
      transition: transform 0.1s ease;
    }

    .totc-btn:hover {
      background: #33241c;
    }

    .totc-btn:active {
      border-style: inset;
      transform: translateY(1px);
    }

    .totc-btn.is-active {
      background: #6b1d1d;
      color: #fff3d6;
      border-color: #c86464;
    }

    .totc-counter {
      background: #140f0c;
      color: #7dff7d;
      border: 2px inset #5c4936;
      font-family: "Courier New", Courier, monospace;
      font-size: 12px;
      font-weight: bold;
      padding: 6px 10px;
      letter-spacing: 1px;
    }

    /* Corner hit celebration badge */
    .totc-corner-toast {
      position: fixed;
      top: 18px;
      left: 50%;
      transform: translateX(-50%) scale(0.9);
      background: #1a120e;
      color: #f5d78e;
      border: 2px solid #c81414;
      font-family: "Courier New", Courier, monospace;
      font-size: 13px;
      font-weight: bold;
      padding: 8px 16px;
      z-index: 100000;
      opacity: 0;
      pointer-events: none;
      transition: opacity 0.2s ease, transform 0.2s ease;
    }

    .totc-corner-toast.show {
      opacity: 1;
      transform: translateX(-50%) scale(1);
    }
  </style>

