  <div class="tw-toast" id="twToast">COPIED TO CLIPBOARD</div>

  <script>
    (function() {
      const STORAGE_KEY = 'dvro_tw_checklist_25_FAM_02560';
      const RECIPIENT = 'LauraMaryNashFurniss260129@gmail.com';
      const HEARING_DATE = new Date('2026-12-03T08:30:00');

      function showToast(msg) {
        const toast = document.getElementById('twToast');
        toast.textContent = msg.toUpperCase();
        toast.classList.add('show');
        setTimeout(() => toast.classList.remove('show'), 2500);
      }

      function updateCountdown() {
        const badge = document.getElementById('twCountdown');
        const now = new Date();
        const diffDays = Math.ceil((HEARING_DATE - now) / (1000 * 60 * 60 * 24));
        if (diffDays > 0) {
          badge.textContent = `HEARING: DEC 03, 2026 (${diffDays}D LEFT)`;
        } else if (diffDays === 0) {
          badge.textContent = 'HEARING: TODAY (DEC 03, 2026)';
        } else {
          badge.textContent = 'HEARING: DEC 03, 2026';
        }
      }

      window.twCopyCaseNo = function() {
        navigator.clipboard.writeText('25-FAM-02560').then(() => {
          showToast('Copied Case No. 25-FAM-02560');
        });
      };

      window.twToggleCard = function(card) {
        const checkbox = card.querySelector('input[type="checkbox"]');
        checkbox.checked = !checkbox.checked;
        processCheckboxState(checkbox, card, true);
      };

      function processCheckboxState(checkbox, card, triggerEmail) {
        const title = checkbox.getAttribute('data-title');
        const desc = checkbox.getAttribute('data-desc');
        const tsEl = card.querySelector('.tw-timestamp');
        const boxEl = card.querySelector('.tw-checkbox-box');

        if (checkbox.checked) {
          const nowStr = new Date().toLocaleString([], { dateStyle: 'medium', timeStyle: 'short' });
          card.classList.add('completed');
          boxEl.textContent = '[X]';
          tsEl.textContent = `LOGGED: ${nowStr}`;
          if (triggerEmail) {
            sendNotificationEmail(title, desc, nowStr);
          }
        } else {
          card.classList.remove('completed');
          boxEl.textContent = '[ ]';
          tsEl.textContent = '';
        }

        saveProgress();
        updateProgressUI();
      }

      function updateProgressUI() {
        const cards = document.querySelectorAll('#dvro-typewriter-wrapper .tw-task-card');
        let completed = 0;
        cards.forEach(card => {
          if (card.classList.contains('completed')) completed++;
        });
        const total = cards.length;
        const pct = Math.round((completed / total) * 100);

        document.getElementById('twProgressBar').style.width = pct + '%';
        document.getElementById('twProgressText').textContent = `${completed} / ${total} COMPLETED (${pct}%)`;
        document.getElementById('twStatusLabel').textContent = completed === total ? 'STATUS: ALL ITEMS CLEARED' : 'STATUS: IN PROGRESS';
      }

      function saveProgress() {
        const state = {};
        document.querySelectorAll('#dvro-typewriter-wrapper .tw-task-card').forEach(card => {
          const id = card.getAttribute('data-id');
          const checked = card.querySelector('input[type="checkbox"]').checked;
          const timestamp = card.querySelector('.tw-timestamp').textContent;
          state[id] = { checked, timestamp };
        });
        localStorage.setItem(STORAGE_KEY, JSON.stringify(state));
      }

      function loadProgress() {
        const raw = localStorage.getItem(STORAGE_KEY);
        if (!raw) return;
        const state = JSON.parse(raw);
        document.querySelectorAll('#dvro-typewriter-wrapper .tw-task-card').forEach(card => {
          const id = card.getAttribute('data-id');
          if (state[id] && state[id].checked) {
            const cb = card.querySelector('input[type="checkbox"]');
            cb.checked = true;
            card.classList.add('completed');
            card.querySelector('.tw-checkbox-box').textContent = '[X]';
            card.querySelector('.tw-timestamp').textContent = state[id].timestamp || 'LOGGED';
          }
        });
        updateProgressUI();
      }

      window.twCopySummary = function() {
        const lines = [
          '====================================================',
          'CASE NO. 25-FAM-02560 (DVRO) — PRE-HEARING AUDIT LOG',
          `GENERATED: ${new Date().toLocaleString()}`,
          '====================================================',
          ''
        ];
        document.querySelectorAll('#dvro-typewriter-wrapper .tw-task-card').forEach((card, i) => {
          const cb = card.querySelector('input[type="checkbox"]');
          const title = cb.getAttribute('data-title');
          const status = cb.checked ? `[X] ${card.querySelector('.tw-timestamp').textContent}` : '[ ] PENDING';
          lines.push(`${i + 1}. ${title}\n    ${status}`);
        });
        navigator.clipboard.writeText(lines.join('\n')).then(() => {
          showToast('Full docket log copied');
        });
      };

      window.twResetChecklist = function() {
        if (confirm('Clear all stamped items and reset this checklist?')) {
          localStorage.removeItem(STORAGE_KEY);
          document.querySelectorAll('#dvro-typewriter-wrapper .tw-task-card').forEach(card => {
            card.querySelector('input[type="checkbox"]').checked = false;
            card.classList.remove('completed');
            card.querySelector('.tw-checkbox-box').textContent = '[ ]';
            card.querySelector('.tw-timestamp').textContent = '';
          });
          updateProgressUI();
          showToast('Docket sheet reset');
        }
      };

      function sendNotificationEmail(taskTitle, taskDetails, timestamp) {
        const subject = encodeURIComponent(`Completed Step [25-FAM-02560]: ${taskTitle}`);
        const body = encodeURIComponent(
          `Hello,\n\nThe following step for Case No. 25-FAM-02560 has been completed and struck from the checklist:\n\n` +
          `STEP: ${taskTitle}\n` +
          `DETAILS: ${taskDetails}\n\n` +
          `STATUS: CLEARED\n` +
          `TIMESTAMP: ${timestamp}`
        );
        setTimeout(() => {
          window.location.href = `mailto:${RECIPIENT}?subject=${subject}&body=${body}`;
        }, 120);
      }

      updateCountdown();
      loadProgress();
    })();
  </script>
