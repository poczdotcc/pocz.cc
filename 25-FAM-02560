<div id="dvro-typewriter-wrapper">
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Courier+Prime:ital,wght@0,400;0,700;1,400&family=Special+Elite&display=swap');

    #dvro-typewriter-wrapper {
      --paper-bg: #f4efe6;
      --card-bg: #fbf8f1;
      --ink-black: #1c1b18;
      --ink-faded: #57534a;
      --ribbon-red: #9b2226;
      --stamp-green: #2d5a27;
      --border-ink: #b8b0a0;

      font-family: 'Courier Prime', 'Courier New', Courier, monospace;
      background-color: var(--paper-bg);
      background-image: radial-gradient(rgba(28, 27, 24, 0.04) 1px, transparent 0);
      background-size: 16px 16px;
      color: var(--ink-black);
      padding: 28px 24px;
      max-width: 820px;
      margin: 0 auto;
      border: 2px solid var(--ink-black);
      box-shadow: 6px 6px 0px rgba(28, 27, 24, 0.18);
      line-height: 1.55;
      box-sizing: border-box;
      position: relative;
    }

    #dvro-typewriter-wrapper *,
    #dvro-typewriter-wrapper *::before,
    #dvro-typewriter-wrapper *::after {
      box-sizing: border-box;
    }

    /* Top Dossier Header */
    .tw-header {
      background: var(--card-bg);
      border: 1.5px solid var(--ink-black);
      padding: 20px;
      margin-bottom: 26px;
      position: relative;
    }

    .tw-header::before {
      content: "DOCKET FILE // RESPONDENT DEFENSE CHECKLIST";
      display: block;
      font-size: 11px;
      letter-spacing: 1.5px;
      color: var(--ink-faded);
      border-bottom: 1px dashed var(--border-ink);
      padding-bottom: 6px;
      margin-bottom: 12px;
    }

    .tw-header-top {
      display: flex;
      flex-wrap: wrap;
      justify-content: space-between;
      align-items: flex-start;
      gap: 12px;
      margin-bottom: 10px;
    }

    .tw-title {
      font-family: 'Special Elite', 'Courier Prime', monospace;
      color: var(--ink-black);
      margin: 0;
      font-size: 23px;
      letter-spacing: 0.5px;
      font-weight: 400;
    }

    .tw-badges {
      display: flex;
      gap: 8px;
      flex-wrap: wrap;
    }

    .tw-badge {
      background: transparent;
      color: var(--ink-black);
      font-size: 12px;
      font-weight: 700;
      padding: 4px 10px;
      border: 1.5px solid var(--ink-black);
      cursor: pointer;
      user-select: none;
      transition: background 0.15s ease;
    }

    .tw-badge:hover {
      background: rgba(28, 27, 24, 0.08);
    }

    .tw-badge.ribbon-red {
      color: var(--ribbon-red);
      border-color: var(--ribbon-red);
      cursor: default;
    }

    .tw-subtitle {
      margin: 0;
      font-size: 13.5px;
      color: var(--ink-faded);
    }

    .tw-subtitle strong {
      color: var(--ink-black);
      text-decoration: underline;
    }

    /* Mechanical Progress Bar */
    .tw-progress-wrap {
      margin-top: 16px;
      padding-top: 12px;
      border-top: 1px dashed var(--border-ink);
    }

    .tw-progress-container {
      background: #e5dec9;
      border: 1px solid var(--ink-black);
      height: 12px;
      width: 100%;
      padding: 1px;
    }

    .tw-progress-bar {
      background: repeating-linear-gradient(
        45deg,
        var(--ink-black),
        var(--ink-black) 6px,
        #3d3a33 6px,
        #3d3a33 12px
      );
      height: 100%;
      width: 0%;
      transition: width 0.3s ease;
    }

    .tw-progress-meta {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-top: 6px;
      font-size: 12px;
      color: var(--ink-black);
      font-weight: 700;
    }

    /* Section Headers */
    .tw-section-title {
      font-family: 'Special Elite', 'Courier Prime', monospace;
      color: var(--ribbon-red);
      margin-top: 28px;
      margin-bottom: 12px;
      font-size: 15px;
      letter-spacing: 0.8px;
      text-transform: uppercase;
      border-bottom: 1.5px solid var(--ink-black);
      padding-bottom: 4px;
    }

    /* Task Sheets */
    .tw-task-card {
      background: var(--card-bg);
      border: 1px solid var(--border-ink);
      border-left: 4px solid var(--ink-black);
      padding: 15px 16px;
      margin-bottom: 12px;
      display: flex;
      align-items: flex-start;
      gap: 14px;
      cursor: pointer;
      transition: transform 0.1s ease, background-color 0.2s ease;
      user-select: none;
      position: relative;
      overflow: hidden;
    }

    .tw-task-card:hover {
      background: #fffdf9;
      border-color: var(--ink-black);
      transform: translateX(2px);
    }

    /* Custom Typewriter Key/Box Checkbox */
    .tw-checkbox-box {
      font-size: 18px;
      font-weight: 700;
      line-height: 1.2;
      color: var(--ink-black);
      flex-shrink: 0;
      margin-top: 1px;
    }

    .tw-task-card input[type="checkbox"] {
      display: none;
    }

    .tw-task-content {
      flex: 1;
      padding-right: 10px;
    }

    .tw-task-title {
      font-weight: 700;
      font-size: 15.5px;
      margin-bottom: 4px;
      color: var(--ink-black);
    }

    .tw-task-desc {
      font-size: 13.5px;
      color: var(--ink-faded);
    }

    .tw-timestamp {
      display: none;
      margin-top: 8px;
      font-size: 12px;
      font-weight: 700;
      color: var(--stamp-green);
    }

    /* Completed Rubber Stamp State */
    .tw-task-card.completed {
      background-color: #efeadf;
      border-left-color: var(--stamp-green);
    }

    .tw-task-card.completed .tw-task-title,
    .tw-task-card.completed .tw-task-desc {
      text-decoration: line-through;
      text-decoration-color: var(--ribbon-red);
      text-decoration-thickness: 1.5px;
      color: #827c70;
    }

    .tw-task-card.completed .tw-timestamp {
      display: block;
    }

    .tw-stamp {
      display: none;
      font-family: 'Special Elite', monospace;
      color: var(--stamp-green);
      border: 2px solid var(--stamp-green);
      padding: 2px 8px;
      font-size: 12px;
      letter-spacing: 1.5px;
      text-transform: uppercase;
      transform: rotate(-4deg);
      opacity: 0.85;
      align-self: center;
      flex-shrink: 0;
    }

    .tw-task-card.completed .tw-stamp {
      display: inline-block;
    }

    /* Action Buttons */
    .tw-footer-actions {
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
      margin-top: 26px;
      padding-top: 16px;
      border-top: 1.5px dashed var(--ink-black);
    }

    .tw-btn {
      font-family: 'Courier Prime', monospace;
      background: var(--card-bg);
      border: 1.5px solid var(--ink-black);
      color: var(--ink-black);
      padding: 8px 14px;
      font-size: 13px;
      font-weight: 700;
      cursor: pointer;
      box-shadow: 2px 2px 0px var(--ink-black);
      transition: transform 0.1s ease, box-shadow 0.1s ease;
    }

    .tw-btn:hover {
      background: #ebe4d5;
    }

    .tw-btn:active {
      transform: translate(2px, 2px);
      box-shadow: 0px 0px 0px var(--ink-black);
    }

    .tw-btn-primary {
      background: var(--ink-black);
      color: var(--card-bg);
    }

    .tw-btn-primary:hover {
      background: #33312c;
    }

    /* Toast Notification */
    .tw-toast {
      position: fixed;
      bottom: 20px;
      right: 20px;
      background: var(--ink-black);
      color: var(--card-bg);
      border: 1.5px solid var(--card-bg);
      padding: 10px 16px;
      font-family: 'Courier Prime', monospace;
      font-size: 13px;
      font-weight: 700;
      opacity: 0;
      pointer-events: none;
      transition: opacity 0.2s ease;
      z-index: 9999;
    }

    .tw-toast.show {
      opacity: 1;
    }

    @media print {
      #dvro-typewriter-wrapper {
        background: #fff !important;
        box-shadow: none !important;
        border: 1px solid #000;
        padding: 12px;
      }
      .tw-footer-actions,
      .tw-toast {
        display: none !important;
      }
      .tw-task-card {
        break-inside: avoid;
        background: #fff !important;
      }
    }
  </style>

